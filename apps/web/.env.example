# Only needed for `npm run dev` outside Docker; the image bakes these in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_TOKEN_EXPIRATION=86400000
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRATION=604800000
NEXT_PUBLIC_TOKEN_KEY=likeme_access_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=likeme_refresh_token
