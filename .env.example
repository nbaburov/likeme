# Copy to .env, then fill in. Generate secrets with: openssl rand -base64 48
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Must be at least 32 bytes (HS256).
JWT_SECRET=

# Optional: leave blank and approval emails (with their setup link) are written to the API log instead.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Password for every seeded account.
DEMO_PASSWORD=demo1234

# Host port for the web app, if 3000 is taken.
WEB_PORT=3000
